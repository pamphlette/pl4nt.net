---
import BlogLayout from '../layouts/BlogLayout.astro'; 

const pageTitle = "about";

const identity = {
    name: "pamphlette",
    country: "French Samoa",
    occupation: "ballet person",
    hobbies: ["photography", "birdwatching", "baseball"],
};
const skills = ["HTML", "CSS", "Yer mum"]

const happy = true;
const done = false;
const goal = 3;

---
<BlogLayout pageTitle={pageTitle}>
    <h2>myself, etc</h2>
    
    <p>some facts:</p>
    <ul>
        <li>name: {identity.name}</li>
        <li>country: {identity.country}</li>
        <li>job: {identity.occupation}</li>
        <li>two hobbies: {identity.hobbies[0]} and {identity.hobbies[2]}</li>
    </ul>

    <p>my skills:</p>
    <ul>
        {skills.map((skill) => <li class="skill">{skill}</li>)}
    </ul>

    {happy && <p>I am happy to be alive</p>}
    {done && <p> I am done with the foundation (it was a lot of books)</p>}
    {goal == 3 ? <p>I wanna be done in 3 days</p> : <p>I don't wanna be done in 3 days</p>}

    <p><img src="/bender.png"></p>
</BlogLayout>

