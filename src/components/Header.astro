---
import Menu from './Menu.astro';
import Navigation from './Navigation.astro';

---
<header>
    <span class="site-name">pl4nt.net</span>
    <nav>
        <Menu />
        <Navigation />
    </nav>
    <span class="browser-time" id="local-time"></span>
        <script>
            const elem = document.getElementById('local-time');
  
            if (elem) {const update = () => {
                    elem.textContent = new Date().toLocaleTimeString("en-US", {timeStyle: "short", hour12: false});
                };

                update();
                setInterval(update, 1000); }
        </script>
</header>